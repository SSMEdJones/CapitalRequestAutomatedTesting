@using CapitalRequestAutomatedTesting.UI.Enums

@model ScenarioComparisonResult

<style media="print">
    .no-print {
        display: none;
    }

    table {
        page-break-inside: avoid;
    }

    .section {
        page-break-after: always;
    }

    .table-warning td {
        background-color: #ff6961;
    }

    .table-warning td {
        background-color: #ff6961;
    }
</style>


<style>
    .table-warning td {
        background-color: #ff6961;
    }
</style>
@Html.Partial("_SelectedProperties", Model.SelectedProperties)

