@using CapitalRequestAutomatedTesting.UI.ScenarioFramework
@model ScenarioDetailsViewModel

<div>

    <div class="form-group">
        <label asp-for="SubmitUserId" class="control-label"></label>
        <select asp-for="SubmitUserId" asp-items="Model.SubmitUsers" class="form-control">
            <option value="">-- Select Submit User--</option>
        </select>
    </div>

    <div class="form-check">
        <input asp-for="PauseBeforeSubmit" class="form-check-input" type="checkbox" id="PauseBeforeSubmit" />
        <label class="form-check-label" for="PauseBeforeSubmit">
            Pause before submit (manual interaction)
        </label>
    </div>
</div>

