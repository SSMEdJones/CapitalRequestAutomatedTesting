@using CapitalRequestAutomatedTesting.UI.ScenarioFramework
@model ScenarioDetailsViewModel

<div>

    <div class="form-group">
        <label asp-for="VerifyingGroupId" class="control-label"></label>
        <select asp-for="VerifyingGroupId" asp-items="Model.VerifyingGroups" class="form-control">
            <option value="">-- Select One --</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="ReviewerId" class="control-label"></label>
        <select asp-for="ReviewerId" asp-items="Model.Reviewers" class="form-control">
            <option value="">-- Select Reviewer --</option>
        </select>
    </div>

    <div class="form-check">
        <input asp-for="PauseBeforeSubmit" class="form-check-input" type="checkbox" id="PauseBeforeSubmit" />
        <label class="form-check-label" for="PauseBeforeSubmit">
            Pause before submit (manual interaction)
        </label>
    </div>
</div>

