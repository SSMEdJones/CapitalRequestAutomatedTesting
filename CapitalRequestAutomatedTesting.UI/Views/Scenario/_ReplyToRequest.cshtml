@using CapitalRequestAutomatedTesting.UI.ScenarioFramework
@model ScenarioDetailsViewModel

<input type="hidden" asp-for="RequestedInfoId" />
<input type="hidden" asp-for="FileUploadPaths" />

<div>
    <div class="form-group">
        <label asp-for="ReplyingGroupId" class="control-label"></label>
        <select asp-for="ReplyingGroupId" asp-items="Model.ReplyingGroups" class="form-control">
            <option value="">-- Select One --</option>
        </select>
    </div>

    @* <div class="form-group" style="display: none;"> *@
    <div class="form-group">
        <label asp-for="RequestingGroupId" class="control-label"></label>
        <select asp-for="RequestingGroupId" asp-items="Model.RequestingGroups" class="form-control">
            <option value="">-- Select One --</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="ReviewerId" class="control-label"></label>
        <select asp-for="ReviewerId" asp-items="Model.Reviewers" class="form-control">
            <option value="">-- Select Reviewer --</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="ReviewerEmail" class="control-label"></label>
        <input asp-for="ReviewerEmail" class="form-control" readonly />
        <input type="hidden" asp-for="ReviewerEmail" />
    </div>

    <div class="form-group">
        <label asp-for="ReviewerUserId" class="control-label"></label>
        <input asp-for="ReviewerUserId" class="form-control" readonly />
        <input type="hidden" asp-for="ReviewerUserId" />
    </div>

    <div class="form-group">
        <label asp-for="RequestedInformation" class="control-label"></label>
        <textarea asp-for="RequestedInformation" class="form-control" readonly></textarea>
    </div>

    <div class="form-group">
        <label asp-for="ReturnedInformation" class="control-label"></label>
        <textarea asp-for="ReturnedInformation" class="form-control"></textarea>
    </div>


    <div class="form-group">
        <label>Select Files One at a Time</label>
        <input type="file" id="filePicker" class="form-control" />
        <button type="button" id="addFileButton">Add File</button>
    </div>

    <ul id="fileList" class="list-group mt-2">
        <!-- JavaScript will populate this -->
    </ul>


</div>

